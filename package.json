{
  "name": "omni-relay",
  "version": "0.2.0",
  "description": "以卡片为一等公民的 API 绑定框架:把任意源站 API 包装为可复用的 API 卡片,业务卡片用命令式双钩子(collect/respond)在 IR 键值缓存上编排它们;IR 是框架执行宿主规则(注入/屏蔽/审计)的介入面。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzvka/omni-relay.git"
  },
  "bugs": {
    "url": "https://github.com/suzvka/omni-relay/issues"
  },
  "homepage": "https://github.com/suzvka/omni-relay#readme",
  "keywords": [
    "api-gateway",
    "relay",
    "schema-validation",
    "zod",
    "upstream",
    "sse",
    "middleware"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.cts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  }
}
